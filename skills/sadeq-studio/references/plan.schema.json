{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sadeq Studio agent plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "memory_revision",
    "base_fingerprint",
    "selected_assets",
    "asset_fingerprints",
    "reason",
    "renderer",
    "ratio",
    "clips"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "memory_revision": {
      "type": "integer"
    },
    "base_fingerprint": {
      "type": "string"
    },
    "selected_assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "asset_fingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string",
      "maxLength": 2000
    },
    "title": {
      "type": "string",
      "maxLength": 100
    },
    "work_id": {
      "type": "string"
    },
    "renderer": {
      "enum": [
        "remotion",
        "hyperframes",
        "basic"
      ]
    },
    "ratio": {
      "enum": [
        "9:16",
        "16:9"
      ]
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset",
          "start",
          "end",
          "text"
        ],
        "properties": {
          "asset": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "text": {
            "type": "string",
            "maxLength": 90
          },
          "motion": {
            "enum": [
              "inherit",
              "plain",
              "kinetic",
              "paper",
              "fade",
              "pop",
              "blur"
            ]
          },
          "textY": {
            "type": "number",
            "minimum": 15,
            "maximum": 75
          },
          "textStart": {
            "type": "number",
            "minimum": 0
          },
          "textEnd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "mute": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
